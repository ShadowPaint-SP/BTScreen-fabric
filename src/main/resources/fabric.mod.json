{
  "schemaVersion": 1,
  "id": "btscreen",
  "version": "${version}",
  "name": "BT Screen",
  "description": "The cool way to use baritone",
  "authors": ["ShadowPaint_SP", "Thojo0"],
  "contact": {
    "homepage": "https://www.youtube.com/watch?v=xvFZjo5PgG0",
    "sources": "https://github.com/ShadowPaint-SP/BTScreen-fabric"
  },
  "license": "GPL-3.0",
  "icon": "assets/btscreen/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["de.drvlabs.btscreen.BTScreen"],
    "modmenu": ["de.drvlabs.btscreen.compat.modmenu.ModMenuImpl"]
  },
  "mixins": ["btscreen.mixins.json"],
  "accessWidener": "btscreen.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "baritone-meteor": "*",
    "malilib": ">=0.23.2"
